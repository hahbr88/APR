{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./client/src/*"] },
    "noEmit": true
  },
  "include": ["server.ts", "src/**/*.ts", "shared/**/*.ts", "test/**/*.ts"]
}
