{
  "name": "auto-payment-request",
  "version": "0.1.0",
  "description": "카드 이용내역 기반 지출결의서 작성 데스크톱 애플리케이션",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "pnpm build:server && pnpm build:client && pnpm build:electron",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "pnpm build && node dist/server.js",
    "dev": "concurrently --kill-others --names api,web \"tsx watch server.ts\" \"vite\"",
    "electron:dev": "pnpm build && electron .",
    "electron:smoke": "pnpm build && node scripts/electron-smoke.mjs",
    "electron:dir": "pnpm build && electron-builder --dir",
    "electron:dist": "pnpm build && electron-builder --win portable nsis",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json --noEmit",
    "test": "tsx test/classifier.test.ts && tsx test/schema.test.ts && tsx test/storage.test.ts && tsx test/llm.test.ts && tsx test/integration.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-table": "^9.2.3",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "lucide-react": "^1.34.0",
    "multer": "^2.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
